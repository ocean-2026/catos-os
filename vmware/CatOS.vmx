.encoding = "GBK"
config.version = "8"
virtualHW.version = "16"
displayName = "CatOS"
guestOS = "other"
memsize = "256"

# Stable BIOS UUID; matches the inventory entry in inventory.vmls.
uuid.bios = "56 4d fe e8 ce 56 fd 83-27 e7 cd fc 29 e3 61 3b"

# ---- IDE 0:0 : FAT32 data disk (primary master) ----
# Kernel ata_identify() takes the first IDENTIFY-able drive, so the
# FAT32 volume MUST be primary master (same as QEMU if=ide).
ide0:0.present = "TRUE"
ide0:0.fileName = "catos-data.vmdk"

# ---- IDE 1:0 : boot volume as virtual CD (secondary master) ----
# catos-vX.XX.iso is a GRUB isohybrid image: it carries BOTH an El Torito
# catalog (CD boot) and an isohybrid MBR (HD boot).  El Torito is the
# standard VMware path.
ide1:0.present = "TRUE"
ide1:0.deviceType = "cdrom-image"
ide1:0.fileName = "D:\CatOs\catos-v2.68.3.iso"

# ---- boot order: CD first ----
bios.bootOrder = "cdrom"

usb.present = "FALSE"
sound.present = "TRUE"
ethernet0.present = "TRUE"

# Make the window usable; CatOS is text-mode VGA.
svga.autodetect = "TRUE"
extendedConfigFile = "CatOS.vmxf"
virtualHW.productCompatibility = "hosted"
vmxstats.filename = "CatOS.scoreboard"
numa.autosize.cookie = "10012"
numa.autosize.vcpu.maxPerVirtualNode = "1"
uuid.location = "56 4d 9e b2 d2 e9 47 c4-3a 39 7d 5e db 4f c0 06"
ide0:0.redo = ""
svga.vramSize = "268435456"
vmotion.checkpointFBSize = "134217728"
vmotion.checkpointSVGAPrimarySize = "268435456"
monitor.phys_bits_used = "43"
cleanShutdown = "FALSE"
softPowerOff = "FALSE"
tools.syncTime = "FALSE"
sound.autoDetect = "TRUE"
sound.fileName = "-1"
sound.pciSlotNumber = "16"
ethernet0.connectionType = "nat"
ethernet0.virtualDev = "e1000"
ethernet0.addressType = "generated"
ethernet0.pciSlotNumber = "17"
ethernet0.generatedAddress = "00:0c:29:e3:61:3b"
ethernet0.generatedAddressOffset = "0"
checkpoint.vmState = ""
floppy0.present = "FALSE"
serial0.present = "FALSE"
parallel0.present = "FALSE"
