# CatOS working tree -- ignore build artifacts, disk images and logs.
# Everything ignored here is either reproducible from source or a bulky
# earlier drop; the repository tracks source, documentation and tests.
#
# NOTE ON RULE ORDER: git resolves .gitignore with LAST-MATCH-WINS semantics.
# A negation ("!pattern") only takes effect if it appears AFTER the pattern
# it is meant to override.  The exceptions for the GRUB boot template and the
# build scripts therefore live at the bottom of this file, next to the
# "*.iso" / "*.py" rules they cancel out.

# ---- compiled objects and intermediate link output ----
*.o
*.obj
*.elf
# but the hand-built ELF test image is a tracked build input (see gen_builtin.py)
!kernel_v25/extapp/bin/*.elf
*.pe
*.map
kernel_v25/build/*.bin
kernel_v25/extapp/build/*
!kernel_v25/extapp/build/mkce.py
!kernel_v25/extapp/build/mkso.py
!kernel_v25/extapp/build/mkrel8.py

# ---- bootable artifacts / disk images (hundreds of MB) ----
*.iso
*.img
*.vhdx
*.vhd
*.qcow2

# ---- exceptions to the rules above (must stay BELOW them) ----
# The GRUB boot template is a REQUIRED build input for build.sh: it is the
# proven El Torito no-emulation image that build/patch_work_iso.py rewrites
# to append kernel.bin.  Without it a clean clone cannot produce an ISO, so it
# is tracked even though it is an .iso.
!kernel_v25/build/catos_work.iso

# Kernel build scripts that happen to live in the build/ directory are
# tracked; everything else produced there is not.
!kernel_v25/build/*.py

# Baseline delivery disk (64 MiB) is tracked as the rollback baseline for
# disk/code cross-checking.  Scratch/regression images (test_disk.img,
# qemu_disk_*.img, scratch/*.img) stay ignored.
!kernel_v25/catos_disk.img

# ---- archives of earlier drops ----
*.zip

# ---- debug logs and traces ----
*.log
*.dump
*.ppm

# ---- bulk reference trees kept outside version control ----
# Working copies of earlier drops, not sources of truth:
ot/
extracted/
tmp/
archive_*_2026-*/
Catos_Better_better/
.staging_unpack/
.dsh-acl-diagnostics/
.backups/

# ---- compiler test scratch ----
tests/cc_work/

# ---- OS / editor noise ----
desktop.ini
Thumbs.db
.DS_Store
*.swp
__pycache__/
*.pyc

# ---- WorkBuddy workspace memory (project-local notes, not source) ----
.workbuddy/
trash

# disk image backups (huge, reproducible)
kernel_v25/catos_disk.img.bak-*
kernel_v25/catos_work_kernel.bin

# ---- v2.59 pager/regress scratch artifacts (reproducible from tests) ----
tests/guess_artifacts/
tests/qemu_shots_guess/
tests/regress_logs/
tests/smoke_artifacts/
tests/qemu_shots/
tests/qemu_disk_pager.img
tests/*.ppm
*.ppm

# ---- v2.59: CE build outputs (regenerated by build.sh from extapp/src) ----
kernel_v25/extapp/bin/*.ce
kernel_v25/extapp/pkg/*.catpkg
kernel_v25/node/node.ce
kernel_v25/src/builtin_apps.inc
kernel_v25/src/symtab.inc

# ---- v2.66 (2026-11-20): VM runtime state, never commit ----
*.vmem
*.vmss
*.lck
*.lck/
vmware/*.SCOREBOARD.lock
vmware/*.scoreboard
vmware/*.vmdk

# ---- v2.66: versioned kernel archives / reference snapshots kept out of git ----
/kernel-v*.bin
deliverables/cde-ref/
deliverables/local-edits-pre-v259/
deliverables/font-backup-pre-merge-*/

# ---- v2.71 (2026-11-21): sshd debug dumps / host selftest binaries ----
tests/dumps/
kernel_v25/build/*.exe

# ---- block GUI evidence: screenshots/PPM never committed; serial logs may ----
artifacts/gui-blocks/*.png
artifacts/gui-blocks/*.ppm

# v2.82: release artifacts are shipped outside git (kernel_v25/ 下留档)
kernel_v25/kernel-v*.bin
kernel_v25/catos-v*.iso
